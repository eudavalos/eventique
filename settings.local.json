  "sections_available": [
    "hero", "countdown", "ourStory", "schedule",
    "weddingParty", "gallery", "accommodation", "faq", "rsvp", "footer"
  ],

  "sections_top_level_keys": ["music", "social"],

  "personalized_invitation": {
    "route": "/e/:slug/i/:token",
    "config_fields_weddingconfig": [
      "personalized_full_view", "personalized_hero_badge_enabled", "personalized_hero_badge_label",
      "personalized_greeting_enabled", "personalized_greeting_position",
      "personalized_greeting_title", "personalized_greeting_body",
      "personalized_show_passes", "personalized_passes_label",
      "personalized_show_type_badge", "personalized_show_countdown", "personalized_countdown_label",
      "conditional_flag_meta",
      "personalized_rsvp_step1_title", "personalized_rsvp_step2_attending_title",
      "personalized_rsvp_step2_declined_title", "personalized_rsvp_step2_declined_body",
      "personalized_rsvp_step3_title", "personalized_rsvp_confirmed_title",
      "personalized_rsvp_confirmed_body_attending", "personalized_rsvp_confirmed_body_declined"
    ],
    "template_variables": {
      "passes_label": "{passes}",
      "countdown_label": "{days}"
    },
    "flag_icon_map_note": "FLAG_ICON_MAP en PersonalizedGreeting.tsx y PersonalizedInvitationPage.tsx — solo UI, sin texto",
    "already_responded_links": ["google_calendar", "google_maps", "native_share_api"],
    "google_calendar_url_built_from": ["config.dates.ceremony", "config.couple.displayNames", "config.venues.ceremony"]
