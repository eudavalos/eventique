{
  "session_protocol": {
    "last_session_date": "2026-05-07",
    "last_session_topic": "personalized-ux-youtube-fix-gift-bank-section-merge-deploy",
    "test_count_baseline": 0,
    "note_on_tests": "No automated test suite yet — validation is manual via browser + curl",
    "git_workflow": {
      "initialized": true,
      "remote": "https://github.com/eudavalos/eventique",
      "branch_default": "main",
      "protected_branches": ["main"],
      "push_to_main_requires_coordination": false
    }
  },

  "api": {
    "port": 8700,
    "timeout_ms": 10000,
    "admin_token_env_var": "ADMIN_TOKEN",
    "admin_token_encoding": "none",
    "note_admin_auth": "Bearer token = raw ADMIN_TOKEN value, NEVER base64 encoded"
  },

  "frontend": {
    "port_host": 5176,
    "port_container": 80,
    "vite_dev_port": 5174,
    "build_tool": "vite",
    "node_version": "20-alpine"
  },

  "rsvp": {
    "max_guests_default": 4,
    "max_guests_absolute": 8,
    "min_name_length": 2,
    "max_name_length": 200,
    "max_dietary_length": 500,
    "max_song_request_length": 300,
    "form_steps": 4
  },

  "docker": {
    "healthcheck_interval_s": 30,
    "healthcheck_timeout_s": 5,
    "healthcheck_retries_frontend": 3,
    "healthcheck_retries_api": 5,
    "healthcheck_start_period_api_s": 15,
    "frontend_healthcheck_method": "CMD-SHELL",
    "frontend_healthcheck_host": "127.0.0.1",
    "api_healthcheck_method": "python3-urllib",
    "note_healthcheck": "Use 127.0.0.1 not localhost — Alpine resolves localhost to ::1 (IPv6) but nginx listens on IPv4 only"
  },

  "theme": {
    "palettes_available": ["nature", "rose-gold", "garden", "navy-gold", "sage", "midnight"],
    "default_palette": "nature",
    "palette_nature": {
      "primary": "#3E7B57",
      "primary_light": "#5A9E74",
      "primary_dark": "#2B5840",
      "secondary": "#EFF7EC",
      "accent": "#C9A93C",
      "bg": "#F8FCF6",
      "surface": "#FFFFFF",
      "text": "#1C2D22",
      "text_muted": "#5D7A67",
      "border": "#C4D9CA"
    },
    "fonts_default": {
      "heading": "Cormorant Garamond",
      "subheading": "Playfair Display",
      "body": "Jost"
    }
  },

  "event_types": ["boda", "cumpleanos", "bautismo", "quinceanera", "graduacion", "corporativo"],

  "music": {
    "youtube_embed_params": "enablejsapi=1&autoplay=0&controls=0&rel=0&modestbranding=1&playsinline=1",
    "youtube_embed_requires_origin_param": true,
    "youtube_postmessage_origin": "https://www.youtube.com",
    "youtube_postmessage_origin_note": "NUNCA usar '*' — browsers móvil/estrictos ignoran mensajes wildcard",
    "youtube_onready_required": true,
    "youtube_onready_note": "Comandos enviados antes de onReady son silenciosamente ignorados; usar pendingPlayRef queue",
    "youtube_iframe_min_size_px": 1,
    "youtube_iframe_min_size_note": "0×0 puede causar que el player no inicialice en algunos browsers",
    "youtube_detection_regex": "[?&]v=([a-zA-Z0-9_-]{11})|youtu\\.be\\/([a-zA-Z0-9_-]{11})",
    "youtube_block_detection_timeout_ms": 3000,
    "youtube_onready_safety_timeout_ms": 6000,
    "local_mp3_path": "/public/music/",
    "photos_path": "/public/photos/",
    "admin_youtube_form_fields": ["url", "title", "artist"],
    "config_top_level_keys": ["enabled", "autoplay", "tracks"]
  },

  "media": {
    "max_image_mb": 10,
    "max_audio_mb": 50,
    "serve_path": "/uploads/{slug}/{filename}",
    "storage_path_container": "/app/uploads/",
    "image_toggle_action": "addPhotoToGallery / removePhotoFromGallery",
    "audio_toggle_action": "addTrackToPlayer / removeTrackFromPlayer"
  },

  "deploy": {
    "ssh_host": "eudavalos@raspberrypi",
