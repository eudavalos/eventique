    "pi_architecture": "arm64",
    "cloudflare_tunnel_name": "tecnopowerpy",
    "cloudflare_tunnel_id": "7ff99efa-ac3f-4e5d-acfe-c2dde45fa3b5",
    "cloudflare_config_path_on_pi": "/etc/cloudflared/config.yml",
