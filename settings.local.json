    "save_sections_handler": "saveSections — persists all 10 sections + music + social in single PUT call",
    "config_tab_gift_bank_card": "Datos Bancarios (Obsequio) — toggle + título + cuerpo + CRUD accounts"
  },

  "event_duplication": {
    "endpoint": "POST /events/{source_slug}/duplicate",
    "auth": "Superadmin (global ADMIN_TOKEN)",
    "request_schema": "EventCreate (name, slug, admin_token?)",
    "behavior": "copies EventConfig JSON blob to new slug; returns 404 if source missing, 400 if target slug exists",
    "frontend_trigger": "Clonar button (Copy icon) per row in Eventos tab → opens duplicate modal"
  },

  "auto_memory_protocol": {
    "enabled": true,
    "memory_dir": "C:/Users/EuDavalos/.claude/projects/D--Proyectos-Eventos-Boda/memory/",
    "save_on": "every significant order/response pair",
    "types": ["user", "feedback", "project", "reference"],
    "index_file": "MEMORY.md",
    "session_file_pattern": "session_YYYY_MM_DD_<topic>.md",
    "four_artifact_rule": ["session_*.md", "CLAUDE.md", "settings.local.json", "MEMORY.md"]
  }
