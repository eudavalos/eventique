  "gift_bank": {
    "config_fields": ["gift_bank_enabled", "gift_bank_title", "gift_bank_body", "gift_bank_accounts"],
    "accounts_schema": "Array<{ label: string; value: string }>",
    "admin_state_pattern": "local useState (giftBankAccounts) — igual que musicTracks, NO react-hook-form field",
    "design": "fondo solid var(--color-primary), gift icon flotante, filas glassmorphism con copy-to-clipboard",
    "coexistence_with_registry": "ambas secciones independientes; GiftRegistry renderiza 0/1/2 según flags"
  },

  "admin_panel": {
    "tabs": ["rsvps", "config", "tema", "media", "eventos", "secciones", "invitados"],
    "config_storage": "sqlite:event_config table (single row, JSON blob)",
    "config_endpoint_get": "GET /api/event-config",
    "config_endpoint_put": "PUT /api/event-config",
    "csv_export_available": true,
    "secciones_coverage": [
      "hero", "countdown", "ourStory", "schedule",
      "weddingParty", "accommodation", "gallery", "rsvp", "footer",
      "social", "music"
