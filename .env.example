# ── Eventique — Environment Variables ────────────────────────
# Copia este archivo como .env y completa los valores reales.

# ── Environment ──────────────────────────────────────────────
# Valores: development, staging, production
ENVIRONMENT=development
DEBUG=false

# ── API ───────────────────────────────────────────────────────
# Token secreto global para administración.
# Genera uno seguro con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DEBE cambiar en producción.
ADMIN_TOKEN=change-me-in-production

# Base de datos. SQLite (default) funciona perfectamente en Pi.
# Para PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:////app/data/eventique.db

# URL pública base (para links en emails, QR, etc)
PUBLIC_BASE_URL=http://localhost:5176

# Orígenes permitidos (CORS) — separados por coma, sin espacios
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5176,http://127.0.0.1:5174,http://127.0.0.1:5176,https://eventique.tecnopowerpy.top

# API metadatos
API_TITLE=Eventique API
API_VERSION=1.0.0

# ── Almacenamiento ────────────────────────────────────────────
# Directorio para archivos subidos. En Docker: /app/uploads
UPLOAD_DIR=/app/uploads

# Límites de subida (MB)
MAX_IMAGE_SIZE_MB=10
MAX_AUDIO_SIZE_MB=50

# Tipos MIME permitidos (separados por coma)
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/webm

# Extensiones permitidas (separadas por coma)
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
ALLOWED_AUDIO_EXTENSIONS=mp3,wav,ogg,webm,m4a

# ── Email (opcional) ──────────────────────────────────────────
# Notificaciones de RSVP por email. Desactivado por defecto.
# Para Gmail: genera un "App Password" en tu cuenta Google
# (https://myaccount.google.com/apppasswords)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Rate Limiting (seguridad) ─────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_ADMIN_REQUESTS_PER_MINUTE=120
RATE_LIMIT_RSVP_CHECK_PER_MINUTE=10
RATE_LIMIT_MEDIA_UPLOAD_PER_MINUTE=5

# ── RSVP ──────────────────────────────────────────────────────
RSVP_MAX_GUESTS_DEFAULT=4
RSVP_MAX_GUESTS_ABSOLUTE=8

# ── Seguridad ─────────────────────────────────────────────────
ADMIN_SESSION_TIMEOUT_HOURS=24
TOKEN_HASHING_ENABLED=false
REQUIRE_HTTPS_IN_PRODUCTION=true

# ── Feature Flags ─────────────────────────────────────────────
FEATURE_EMAIL_ENABLED=false
FEATURE_QR_CODES_ENABLED=true
FEATURE_MUSIC_YOUTUBE_ENABLED=true

# ── Frontend ──────────────────────────────────────────────────
# URL de la API usada por Vite en producción
VITE_API_URL=/api
VITE_PUBLIC_BASE_URL=http://localhost:5176
VITE_APP_NAME=Eventique
