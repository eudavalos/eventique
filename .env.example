# ── Eventique — Environment Variables ────────────────────────
# Copia este archivo como .env y completa los valores reales.

# ── API ───────────────────────────────────────────────────────
# Token secreto para el panel de administración (/admin)
# Genera uno seguro con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-in-production

# Base de datos. SQLite (default) funciona perfectamente.
# Para PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:////app/data/eventique.db

# Orígenes permitidos (CORS) — separados por coma, sin espacios
ALLOWED_ORIGINS=http://localhost:5174,https://eventique.tecnopowerpy.top

# ── Frontend ──────────────────────────────────────────────────
# URL de la API usada por Vite en producción
VITE_API_URL=/api
